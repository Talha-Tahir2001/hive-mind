{
  "name": "hive-mind",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "db:schema": "node --import tsx lib/db/apply-schema.ts",
    "db:seed": "node --import tsx lib/db/seed.ts",
    "db:embed": "node --import tsx lib/db/backfill-embeddings.ts",
    "db:vector": "node --import tsx lib/db/apply-vector-index.ts",
    "db:setup": "node --import tsx lib/db/apply-schema.ts && node --import tsx lib/db/seed.ts && node --import tsx lib/db/apply-vector-index.ts",
    "db:test$0": "node --import tsx lib/db/test-connection.ts",
    "pipeline:test": "node --import tsx lib/pipeline/test-pipeline.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1110.0",
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@base-ui/react": "^1.7.0",
    "@clerk/nextjs": "^7.7.5",
    "@tabler/icons-react": "^3.46.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.17.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@clerk/eslint-plugin": "^0.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
